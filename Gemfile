# CocoaPods para la build nativa de iOS.
#
# Requiere Ruby 3.x: los scripts de autolinking de Expo usan `filter_map`, que no
# existe en el Ruby 2.6 que trae macOS, y CocoaPods 1.13+ es lo primero que
# entiende `visionos.deployment_target`. El `.ruby-version` de al lado fija la
# versión para rbenv.
source 'https://rubygems.org'

gem 'cocoapods', '~> 1.16'
