# Copia este archivo a `.env.local` y rellena los valores del proyecto de Supabase.
# Sin ellos la app arranca igualmente: el feed sirve los datos de src/data/mock.ts.
#
# La anon key es pública por diseño (va embebida en el bundle). Lo que protege los
# datos es RLS, no el secreto de esta clave — ver supabase/migrations/0002_rls.sql.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# studio/ — el panel del creador y la landing de Destrier
#
# Van en `studio/.env.local`, no en este de la raíz: son dos proyectos con su
# propio `package.json`. Sin ellas la landing se sirve igual y el formulario cae
# al enlace de correo, que es el camino de la muestra y no se puede romper.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# El dominio real —`destrier.es`, o el que sea— en Plausible. **Sin esta variable
# no se carga analítica ninguna**: en local no se ensucian las cifras.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
